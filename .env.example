# Public URL used when Stripe redirects after checkout. No trailing slash.
NEXT_PUBLIC_APP_URL=https://dispatchready.org

# Supabase project connection. The publishable key is safe for browser use;
# keep the service-role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-only credentials. Use a restricted key (rk_) with only the
# Checkout and webhook permissions required by this product.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRESSURE_PREP_PRICE_ID=

# Displayed in public support and refund information after launch.
SUPPORT_EMAIL=support@dispatchready.org
