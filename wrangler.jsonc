{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criticall",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://dispatchready.org",
    "SUPPORT_EMAIL": "support@dispatchready.org"
  }
}
